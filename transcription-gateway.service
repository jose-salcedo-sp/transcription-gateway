[Unit]
Description=Transcription gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@SERVICE_DIR@
EnvironmentFile=@SERVICE_DIR@/.env
ExecStart=@SERVICE_DIR@/target/release/transcription-gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
